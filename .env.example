# All VITE_* values are baked into the production bundle and are PUBLIC.
# Never put a secret here.

# OAuth 2.0 Web application client ID from Google Cloud Console.
# Must match CONFIG.googleClientId in apps-script/Code.gs or every request fails the aud check.
VITE_GOOGLE_CLIENT_ID=PASTE_YOUR_OAUTH_CLIENT_ID_HERE.apps.googleusercontent.com

# Apps Script web app /exec URL.
VITE_APPS_SCRIPT_ENDPOINT=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID_HERE/exec

# Email domain allowed to submit. Mirrors CONFIG.allowedEmailDomains in Code.gs.
VITE_ALLOWED_EMAIL_DOMAIN=startupmission.in
